spawn(function()
	while task.wait(1) do
		for _,v in pairs(path:GetChildren()) do
			if v:IsA("ModuleScript") then
				local gun = require(v)

				if AmmoToggle then
					gun.AmmoPerMag = AmmoValue
				end

				if FireToggle then
					gun.FireRate = FireRateValue
				end

				if SpreadToggle then
					gun.Spread = SpreadValue
				end

				if BulletToggle then
					gun.ProjectilesPerShot = BulletValue
				end

				if ReloadToggle then
					gun.ReloadTime = 0
				end

			end
		end
	end
end)

